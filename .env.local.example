# Copy file ini menjadi .env.local dan isi dengan nilai dari Supabase dashboard kamu

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (untuk webhook — jangan expose ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cashi.id — dapatkan di Dashboard → Settings → API Keys
CASHI_API_KEY=YOUR_CASHI_API_KEY

# URL publik app kamu (untuk webhook endpoint)
NEXT_PUBLIC_APP_URL=https://warungku.vercel.app
